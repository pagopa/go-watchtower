# AWS ECR Registry (production only)
# Format: <account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=<account-id>.dkr.ecr.<region>.amazonaws.com

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/go_watchtower

# JWT - Use a strong random secret in production (min 32 chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-strong-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_TOKEN_ROTATION_GRACE_SECONDS=300
# CLI PAT hash pepper - keep stable; changing it invalidates existing CLI tokens
# Generate with: openssl rand -base64 32
WATCHTOWER_CLI_TOKEN_PEPPER=change-me-cli-token-pepper

# Google OAuth (required for Google authentication)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Frontend URL (for redirects after OAuth)
FRONTEND_URL=http://localhost:3000

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Runbook Automation — reconciler/dispatch (OPUS-03 §9.9)
# RECONCILER_ENABLED=true invia messaggi su SQS: abilitare solo con registry configurato.
RECONCILER_ENABLED=false
RECONCILER_INTERVAL_MS=60000
# Parametro SSM del queue registry pubblicato da go-automation (vuoto = reconciler solo-DB)
EXECUTE_RUNBOOK_QUEUE_REGISTRY_PARAMETER=/go-automation/<env>/execute-runbook/queue-registry-v1
EXECUTE_RUNBOOK_QUEUE_REGISTRY_REGION=eu-south-1

# Runbook Automation — catalogo capability (EVO-SLACKINGRA-CODEX-03 §9)
# Bucket S3 creato dallo stack SST go-automation nella control region
# (nome deterministico: go-auto-<account-id>-<env>-runbooks). Vuoto = sync disabilitato.
AUTOMATIC_RUNBOOK_CATALOG_BUCKET=go-auto-<account-id>-<env>-runbooks
AUTOMATIC_RUNBOOK_CATALOG_REGION=eu-south-1
# DEVE coincidere con l'environment del catalogo pubblicato, altrimenti il sync lo rifiuta.
AUTOMATIC_RUNBOOK_CATALOG_ENVIRONMENT=production
CATALOG_SYNC_INTERVAL_SECONDS=60
CATALOG_VALIDITY_SECONDS=300

# Token bot Slack usato dal backend per il test read-only di accesso ai canali
# (senza, l'abilitazione canali risponde 503 SLACK_BOT_TOKEN_NOT_CONFIGURED)
SLACK_BOT_TOKEN=xoxb-your-bot-token
