{
  "name": "go-watchtower",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Watchtower veglia sull'infrastruttura digitale di PagoPa 24 ore su 24. Un punto unico di osservazione per allarmi, incidenti e azioni — perché nessun problema passi inosservato.",
  "scripts": {
    "catalog:automatic:import-local": "pnpm --filter @go-watchtower/backend catalog:import-local",
    "lint": "eslint . && pnpm --filter @go-watchtower/frontend lint",
    "type-check": "tsc --noEmit",
    "inventory:aws": "bash scripts/aws-inventory.sh",
    "deploy:frontend": "bash scripts/deploy-frontend.sh",
    "deploy:backend": "bash scripts/deploy-backend.sh",
    "deploy:slack-ingestor": "bash scripts/deploy-slack-ingestor.sh"
  },
  "keywords": [],
  "author": "Team GO - Gestione Operativa",
  "license": "ISC",
  "engines": {
    "node": ">=25.2.0",
    "pnpm": ">=10.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
