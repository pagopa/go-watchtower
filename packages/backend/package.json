{
  "name": "@go-watchtower/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API backend with Fastify",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test:unit": "node --import tsx --test test/**/*.test.ts",
    "rescore": "tsx src/scripts/rescore-analyses.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/jwt": "^10.2.7",
    "@fastify/oauth2": "^8.3.2",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@go-watchtower/database": "workspace:*",
    "@go-watchtower/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.19.2",
    "pino-pretty": "^13.2.0"
  }
}
