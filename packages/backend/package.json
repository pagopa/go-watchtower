{
  "name": "@go-watchtower/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API backend with Fastify",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test:unit": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"test-integration/**/*.test.ts\"",
    "gen:contracts": "tsx src/scripts/export-contract-artifacts.ts",
    "catalog:import-local": "tsx src/scripts/import-local-automatic-runbook-catalog.ts",
    "rescore": "tsx src/scripts/rescore-analyses.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/client-sqs": "^3.1073.0",
    "@aws-sdk/client-ssm": "^3.1073.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/oauth2": "^8.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@go-watchtower/database": "workspace:*",
    "@go-watchtower/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.49",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.9.1",
    "pino-pretty": "^13.1.3"
  }
}
