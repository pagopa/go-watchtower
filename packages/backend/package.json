{
  "name": "@go-watchtower/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API backend with Fastify",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test:unit": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"test-integration/**/*.test.ts\"",
    "gen:contracts": "tsx src/scripts/export-contract-artifacts.ts",
    "catalog:import-local": "tsx src/scripts/import-local-automatic-runbook-catalog.ts",
    "rescore": "tsx src/scripts/rescore-analyses.ts",
    "type-check:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/client-sqs": "^3.1139.0",
    "@aws-sdk/client-ssm": "^3.1139.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/oauth2": "^8.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@go-watchtower/database": "workspace:*",
    "@go-watchtower/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.2",
    "pino-pretty": "^13.1.3"
  }
}
