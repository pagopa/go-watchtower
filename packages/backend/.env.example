# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/go_watchtower?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_TOKEN_ROTATION_GRACE_SECONDS=300
# CLI PAT hash pepper - keep stable; changing it invalidates existing CLI tokens
# Generate with: openssl rand -base64 32
WATCHTOWER_CLI_TOKEN_PEPPER=change-me-cli-token-pepper

# Google OAuth
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Runbook Automation — reconciler/reaper/safety-net/finalizer (+ dispatch su SQS)
# Opt-in: in modalità completa invia messaggi verso SQS, quindi va abilitato esplicitamente.
RECONCILER_ENABLED=false
RECONCILER_INTERVAL_MS=60000
# Registry regionale GA→WT (parametro SSM pubblicato da go-automation, contratto §6).
# Se vuoto, il reconciler gira in sola modalità DB (timeout/recupero/finalizzazione), senza dispatch su SQS.
EXECUTE_RUNBOOK_QUEUE_REGISTRY_PARAMETER=
EXECUTE_RUNBOOK_QUEUE_REGISTRY_REGION=eu-south-1
