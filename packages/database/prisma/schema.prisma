generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum AnalysisType {
  ANALYZABLE
  IGNORABLE
}

enum AnalysisStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
}

enum SystemComponent {
  PRODUCT
  ENVIRONMENT
  RESOURCE
  IGNORED_ALARM
  ALARM_PRIORITY_RULE
  PRIORITY_LEVEL
  RUNBOOK
  FINAL_ACTION
  ALARM
  ALARM_ANALYSIS
  ALARM_EVENT
  DOWNSTREAM
  USER
  SYSTEM_SETTING
  AUTOMATIC_RUNBOOK_EXECUTION
}

enum PermissionScope {
  NONE
  OWN
  ALL
}

enum RunbookStatus {
  DRAFT
  COMPLETE
}

enum AlarmPriorityMatcherType {
  ALARM_ID
  ALARM_NAME_PREFIX
  ALARM_NAME_REGEX
}

// ═══════════════════════════════════════════════════════════
// RUNBOOK AUTOMATION (EVO-WATCHTINTEG-OPUS-03 §9.4)
// ═══════════════════════════════════════════════════════════

enum PrincipalType {
  HUMAN
  SERVICE
}

enum AnalysisOrigin {
  MANUAL
  AUTOMATIC
  HYBRID
}

enum AutomationExecutionStatus {
  PENDING_DISPATCH
  QUEUED
  RUNNING
  RETRY_PENDING
  CANCEL_REQUESTED
  SUCCEEDED
  SKIPPED
  FAILED
  CANCELLED
}

enum AutomationExecutionOutcome {
  KNOWN_CASE
  UNKNOWN_CASE
  NO_DATA
  NO_RUNBOOK
  CONFIGURATION_ERROR
  EXECUTION_ERROR
}

enum AutomationTriggerKind {
  SLACK_INGESTOR
  WATCHTOWER_UI
  WATCHTOWER_API
  RETRY
}

enum AutomationReviewStatus {
  NOT_REQUIRED
  PENDING
  CONFIRMED
  REJECTED
}

enum AutomationMode {
  SHADOW
  APPLY_KNOWN
  APPLY_ALL
}

enum AutomationAttemptStatus {
  RUNNING
  COMPLETED
  INTERRUPTED
  FAILED
  CANCELLED
}

enum AutomationRetryDisposition {
  COMPLETE_OUTCOME
  CANCEL_EXECUTION
  RETRY_MESSAGE
  FAIL_EXECUTION
}

enum AutomationCancellationFinalizedBy {
  IMMEDIATE
  WORKER
  SYSTEM
}

// ═══════════════════════════════════════════════════════════
// ROLES & PERMISSIONS
// ═══════════════════════════════════════════════════════════

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  id        String          @id @default(uuid(7)) @db.Uuid
  roleId    String          @map("role_id") @db.Uuid
  resource  SystemComponent
  canRead   PermissionScope @default(NONE) @map("can_read")
  canWrite  PermissionScope @default(NONE) @map("can_write")
  canDelete PermissionScope @default(NONE) @map("can_delete")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
  // @@index([roleId]) — redundant: covered by @@unique([roleId, resource])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  resource  SystemComponent
  canRead   PermissionScope? @map("can_read")
  canWrite  PermissionScope? @map("can_write")
  canDelete PermissionScope? @map("can_delete")
  grantedBy String?          @map("granted_by") @db.Uuid
  reason    String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user          User  @relation("UserOverrides", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("GrantedOverrides", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, resource])
  // @@index([userId]) — redundant: covered by @@unique([userId, resource])
  @@index([grantedBy])
  @@map("user_permission_overrides")
}

// ═══════════════════════════════════════════════════════════
// USERS
// ═══════════════════════════════════════════════════════════

model User {
  id            String        @id @default(uuid(7)) @db.Uuid
  email         String        @unique
  passwordHash  String?       @map("password_hash")
  name          String
  roleId        String        @map("role_id") @db.Uuid
  provider      AuthProvider  @default(LOCAL)
  providerId    String?       @map("provider_id")
  isActive      Boolean       @default(true) @map("is_active")
  // D4/A1: identità tecnica tipizzata e segregata dagli utenti umani.
  // CHECK in migration: SERVICE ⇒ serviceId NOT NULL; HUMAN ⇒ serviceId NULL.
  principalType PrincipalType @default(HUMAN) @map("principal_type")
  serviceId     String?       @unique @map("service_id")
  preferences   Json          @default("{}") @map("preferences")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  role                           Role                        @relation(fields: [roleId], references: [id])
  permissionOverrides            UserPermissionOverride[]    @relation("UserOverrides")
  grantedOverrides               UserPermissionOverride[]    @relation("GrantedOverrides")
  refreshTokens                  RefreshToken[]
  analyses                       AlarmAnalysis[]             @relation("OperatorAnalyses")
  createdAnalyses                AlarmAnalysis[]             @relation("CreatedByUser")
  updatedAnalyses                AlarmAnalysis[]             @relation("UpdatedByUser")
  updatedSettings                SystemSetting[]             @relation("UpdatedSettings")
  systemEvents                   SystemEvent[]               @relation("UserSystemEvents")
  automationTriggered            AutomaticRunbookExecution[] @relation("AutomationTriggeredBy")
  automationReviewed             AutomaticRunbookExecution[] @relation("AutomationReviewedBy")
  automationCancellationRequests AutomaticRunbookExecution[] @relation("AutomationCancelRequestedBy")

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Product {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  environments  Environment[]
  resources     Resource[]
  finalActions  FinalAction[]
  ignoredAlarms IgnoredAlarm[]
  priorityRules AlarmPriorityRule[]
  runbooks      Runbook[]
  alarms        Alarm[]
  downstreams   Downstream[]
  analyses      AlarmAnalysis[]
  alarmEvents   AlarmEvent[]

  @@map("products")
}

model Environment {
  id                  String   @id @default(uuid(7)) @db.Uuid
  name                String
  description         String?
  order               Int      @default(0)
  productId           String   @map("product_id") @db.Uuid
  slackChannelId      String?  @map("slack_channel_id")
  defaultAwsAccountId String?  @map("default_aws_account_id")
  defaultAwsRegion    String?  @map("default_aws_region")
  onCallAlarmPattern  String?  @map("on_call_alarm_pattern")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  analyses      AlarmAnalysis[]
  ignoredAlarms IgnoredAlarm[]
  priorityRules AlarmPriorityRule[]
  alarmEvents   AlarmEvent[]

  @@unique([productId, name])
  @@map("environments")
}

model ResourceType {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  resources Resource[]

  @@map("resource_types")
}

model Resource {
  id          String             @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  typeId      String             @map("type_id") @db.Uuid
  productId   String             @map("product_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  type        ResourceType       @relation(fields: [typeId], references: [id])
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  analyses    AnalysisResource[]

  @@unique([productId, name])
  @@index([typeId])
  @@map("resources")
}

model IgnoredAlarm {
  id            String   @id @default(uuid(7)) @db.Uuid
  alarmId       String   @map("alarm_id") @db.Uuid
  environmentId String   @map("environment_id") @db.Uuid
  reason        String?
  isActive      Boolean  @default(true) @map("is_active")
  productId     String   @map("product_id") @db.Uuid
  validity      Json     @default("[]")
  exclusions    Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  alarm       Alarm       @relation(fields: [alarmId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([alarmId, environmentId])
  @@index([productId])
  @@index([environmentId])
  @@map("ignored_alarms")
}

model PriorityLevel {
  code           String   @id
  label          String
  description    String?
  rank           Int      @default(0)
  color          String?
  icon           String?
  isActive       Boolean  @default(true) @map("is_active")
  isDefault      Boolean  @default(false) @map("is_default")
  countsAsOnCall Boolean  @default(false) @map("counts_as_on_call")
  defaultNotify  Boolean  @default(false) @map("default_notify")
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  rules       AlarmPriorityRule[]
  alarmEvents AlarmEvent[]

  @@index([isActive])
  @@index([isDefault])
  @@index([rank])
  @@map("priority_levels")
}

model Alarm {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  productId   String   @map("product_id") @db.Uuid
  runbookId   String?  @map("runbook_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  runbook       Runbook?            @relation(fields: [runbookId], references: [id], onDelete: SetNull)
  analyses      AlarmAnalysis[]
  ignoredAlarms IgnoredAlarm[]
  priorityRules AlarmPriorityRule[]
  alarmEvents   AlarmEvent[]

  @@unique([productId, name])
  @@index([runbookId])
  @@map("alarms")
}

model AlarmPriorityRule {
  id            String                   @id @default(uuid(7)) @db.Uuid
  productId     String                   @map("product_id") @db.Uuid
  environmentId String?                  @map("environment_id") @db.Uuid
  priorityCode  String                   @map("priority_code")
  name          String
  matcherType   AlarmPriorityMatcherType @map("matcher_type")
  alarmId       String?                  @map("alarm_id") @db.Uuid
  namePrefix    String?                  @map("name_prefix")
  namePattern   String?                  @map("name_pattern")
  precedence    Int                      @default(0)
  note          String?
  isActive      Boolean                  @default(true) @map("is_active")
  validity      Json                     @default("[]")
  exclusions    Json                     @default("[]")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  environment Environment?  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  priority    PriorityLevel @relation(fields: [priorityCode], references: [code], onDelete: Restrict)
  alarm       Alarm?        @relation(fields: [alarmId], references: [id], onDelete: Cascade)
  alarmEvents AlarmEvent[]

  @@index([productId, isActive])
  @@index([productId, environmentId, isActive])
  @@index([productId, alarmId, environmentId, isActive])
  @@index([priorityCode])
  @@map("alarm_priority_rules")
}

model Runbook {
  id          String        @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  link        String
  status      RunbookStatus @default(DRAFT)
  productId   String        @map("product_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  alarms   Alarm[]
  analyses AlarmAnalysis[]

  @@unique([productId, name])
  @@map("runbooks")
}

model FinalAction {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  order       Int      @default(0)
  isOther     Boolean  @default(false) @map("is_other")
  productId   String   @map("product_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product  Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  analyses AnalysisFinalAction[]

  @@unique([productId, name])
  @@map("final_actions")
}

model IgnoreReason {
  code          String  @id
  label         String
  description   String?
  sortOrder     Int     @default(0) @map("sort_order")
  // JSON Schema (draft-07) che descrive i campi attesi in ignoreDetails
  // null = nessun dettaglio richiesto
  detailsSchema Json?   @map("details_schema")

  analyses AlarmAnalysis[]

  @@map("ignore_reasons")
}

model AlarmAnalysis {
  id                     String         @id @default(uuid(7)) @db.Uuid
  analysisDate           DateTime       @map("analysis_date")
  firstAlarmAt           DateTime       @map("first_alarm_at")
  lastAlarmAt            DateTime       @map("last_alarm_at")
  occurrences            Int            @default(1)
  isOnCall               Boolean        @default(false) @map("is_on_call")
  analysisType           AnalysisType   @default(ANALYZABLE) @map("analysis_type")
  status                 AnalysisStatus @default(CREATED) @map("status")
  alarmId                String         @map("alarm_id") @db.Uuid
  errorDetails           String?        @map("error_details")
  conclusionNotes        String?        @map("conclusion_notes")
  ignoreReasonCode       String?        @map("ignore_reason_code")
  ignoreDetails          Json?          @map("ignore_details")
  operatorId             String         @map("operator_id") @db.Uuid
  productId              String         @map("product_id") @db.Uuid
  environmentId          String         @map("environment_id") @db.Uuid
  runbookId              String?        @map("runbook_id") @db.Uuid
  links                  Json           @default("[]")
  trackingIds            Json           @default("[]") @map("tracking_ids")
  validationScore        Int?           @map("validation_score") @db.SmallInt
  qualityScore           Int?           @map("quality_score") @db.SmallInt
  scoredAt               DateTime?      @map("scored_at")
  // Runbook Automation (§9.2/§9.4): provenienza analisi e puntatore all'esecuzione
  // che ha prodotto il contenuto corrente (rami 1/2). HYBRID = automatica poi modificata.
  origin                 AnalysisOrigin @default(MANUAL)
  lastAppliedExecutionId String?        @map("last_applied_execution_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  createdById            String         @map("created_by_id") @db.Uuid
  updatedById            String?        @map("updated_by_id") @db.Uuid

  alarm        Alarm         @relation(fields: [alarmId], references: [id], onDelete: Restrict)
  operator     User          @relation("OperatorAnalyses", fields: [operatorId], references: [id], onDelete: Restrict)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  environment  Environment   @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  runbook      Runbook?      @relation(fields: [runbookId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?         @relation("UpdatedByUser", fields: [updatedById], references: [id], onDelete: Restrict)
  ignoreReason IgnoreReason? @relation(fields: [ignoreReasonCode], references: [code])

  lastApplied AutomaticRunbookExecution? @relation("AnalysisLastApplied", fields: [lastAppliedExecutionId], references: [id], onDelete: SetNull)

  resources         AnalysisResource[]
  downstreams       AnalysisDownstream[]
  finalActions      AnalysisFinalAction[]
  alarmEvents       AlarmEvent[]
  runbookExecutions AutomaticRunbookExecution[] @relation("ExecutionAnalysis")

  @@index([analysisDate])
  // @@index([productId]) — redundant: covered by @@index([productId, analysisDate])
  @@index([environmentId])
  @@index([environmentId, analysisDate])
  @@index([operatorId])
  @@index([alarmId])
  @@index([productId, analysisDate])
  @@index([productId, status])
  @@index([createdAt])
  // @@index([analysisType]) — low cardinality (2 values), never used as leading filter
  // @@index([status]) — low cardinality (3 values), never used as leading filter
  @@index([runbookId])
  @@index([ignoreReasonCode])
  @@index([createdById])
  @@index([updatedById])
  @@index([productId, environmentId, analysisDate])
  @@index([links], type: Gin)
  @@index([trackingIds], type: Gin)
  @@map("alarm_analyses")
}

model AnalysisResource {
  analysisId String @map("analysis_id") @db.Uuid
  resourceId String @map("resource_id") @db.Uuid

  analysis AlarmAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  resource Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([analysisId, resourceId])
  @@index([resourceId])
  @@map("analysis_resources")
}

model Downstream {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  productId   String   @map("product_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product  Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  analyses AnalysisDownstream[]

  @@unique([productId, name])
  @@map("downstreams")
}

model AnalysisDownstream {
  analysisId   String @map("analysis_id") @db.Uuid
  downstreamId String @map("downstream_id") @db.Uuid

  analysis   AlarmAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  downstream Downstream    @relation(fields: [downstreamId], references: [id], onDelete: Cascade)

  @@id([analysisId, downstreamId])
  @@index([downstreamId])
  @@map("analysis_downstreams")
}

model AnalysisFinalAction {
  analysisId    String @map("analysis_id") @db.Uuid
  finalActionId String @map("final_action_id") @db.Uuid

  analysis    AlarmAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  finalAction FinalAction   @relation(fields: [finalActionId], references: [id], onDelete: Cascade)

  @@id([analysisId, finalActionId])
  @@index([finalActionId])
  @@map("analysis_final_actions")
}

// ═══════════════════════════════════════════════════════════
// ALARM EVENTS
// ═══════════════════════════════════════════════════════════

model AlarmEvent {
  id                 String    @id @default(uuid(7)) @db.Uuid
  name               String
  firedAt            DateTime  @map("fired_at")
  description        String?
  reason             String?
  awsRegion          String    @map("aws_region")
  awsAccountId       String    @map("aws_account_id")
  productId          String    @map("product_id") @db.Uuid
  environmentId      String    @map("environment_id") @db.Uuid
  alarmId            String?   @map("alarm_id") @db.Uuid
  analysisId         String?   @map("analysis_id") @db.Uuid
  priorityCode       String    @default("NORMAL") @map("priority_code")
  priorityRuleId     String?   @map("priority_rule_id") @db.Uuid
  priorityResolvedAt DateTime? @map("priority_resolved_at")
  linkedAt           DateTime? @map("linked_at")
  resolvedAt         DateTime? @map("resolved_at")
  // Identificatore univoco del messaggio Slack sorgente — formato "{channelId}/{ts}".
  // Usato per prevenire duplicati quando lo script di ingestione rilegge messaggi già processati.
  slackMessageId     String?   @unique @map("slack_message_id")
  createdAt          DateTime  @default(now()) @map("created_at")

  product           Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  environment       Environment                 @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  alarm             Alarm?                      @relation(fields: [alarmId], references: [id], onDelete: SetNull)
  analysis          AlarmAnalysis?              @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  priority          PriorityLevel               @relation(fields: [priorityCode], references: [code], onDelete: Restrict)
  priorityRule      AlarmPriorityRule?          @relation(fields: [priorityRuleId], references: [id], onDelete: SetNull)
  // NON Cascade: la storia execution è append-only e deve sopravvivere (§9.4).
  runbookExecutions AutomaticRunbookExecution[] @relation("ExecutionAlarmEvent")

  @@index([firedAt])
  @@index([productId, firedAt])
  @@index([environmentId])
  @@index([environmentId, firedAt])
  @@index([awsAccountId])
  @@index([alarmId])
  @@index([analysisId])
  @@index([priorityCode])
  @@index([priorityRuleId])
  @@index([productId, priorityCode, firedAt])
  @@index([environmentId, priorityCode, firedAt])
  @@map("alarm_events")
}

// Cursori di avanzamento per l'ingestione incrementale di messaggi Slack.
// Ogni record tiene traccia del timestamp Slack (ts) dell'ultimo messaggio
// processato per canale, evitando reingestioni duplicate.
model SlackChannelCursor {
  channelId String   @id @map("channel_id")
  latestTs  String   @map("latest_ts")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("slack_channel_cursors")
}

// ═══════════════════════════════════════════════════════════
// IMPOSTAZIONI DI SISTEMA
// ═══════════════════════════════════════════════════════════

model SystemSetting {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  value       Json
  // valori gestiti dalla costante SettingType in @go-watchtower/shared
  type        String
  // formato semantico del valore — gestito dalla costante SettingFormats in @go-watchtower/shared
  // null per tipi primitivi o JSON senza shape specifica
  format      String?
  // valori gestiti dalla costante SettingCategory in @go-watchtower/shared
  category    String
  label       String
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("UpdatedSettings", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@map("system_settings")
}

// ═══════════════════════════════════════════════════════════
// LOG DEGLI EVENTI DI SISTEMA
// ═══════════════════════════════════════════════════════════

model SystemEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  // nome/email dell'utente al momento dell'evento (denormalizzato)
  userLabel     String?  @map("user_label")
  // valori gestiti dalla costante SystemEventAction in @go-watchtower/shared
  action        String
  // valori gestiti dalla costante SystemEventResource in @go-watchtower/shared
  resource      String?
  resourceId    String?  @map("resource_id")
  // label della risorsa al momento dell'evento (denormalizzato)
  resourceLabel String?  @map("resource_label")
  metadata      Json     @default("{}")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation("UserSystemEvents", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("system_events")
}

// ═══════════════════════════════════════════════════════════
// RUNBOOK AUTOMATION — EXECUTIONS & ATTEMPTS (EVO-WATCHTINTEG-OPUS-03 §9.4)
// ═══════════════════════════════════════════════════════════

model AutomaticRunbookExecution {
  id                      String                             @id @default(uuid(7)) @db.Uuid // = executionId: SQS MessageDeduplicationId + chiave apply-once
  parentExecutionId       String?                            @map("parent_execution_id") @db.Uuid
  requestKey              String?                            @unique @map("request_key") // idempotenza CREAZIONE iniziale: "SLACK:<alarmEventId>"; null per manuale/re-launch
  alarmEventId            String                             @map("alarm_event_id") @db.Uuid
  analysisId              String?                            @map("analysis_id") @db.Uuid
  productId               String                             @map("product_id") @db.Uuid
  environmentId           String                             @map("environment_id") @db.Uuid
  alarmId                 String?                            @map("alarm_id") @db.Uuid
  status                  AutomationExecutionStatus
  outcome                 AutomationExecutionOutcome?
  reviewStatus            AutomationReviewStatus             @default(NOT_REQUIRED) @map("review_status")
  reviewedByUserId        String?                            @map("reviewed_by_user_id") @db.Uuid
  reviewedByLabel         String?                            @map("reviewed_by_label")
  reviewedAt              DateTime?                          @map("reviewed_at")
  cancelRequestedByUserId String?                            @map("cancel_requested_by_user_id") @db.Uuid
  cancelRequestedByLabel  String?                            @map("cancel_requested_by_label")
  cancelRequestId         String?                            @unique @map("cancel_request_id") @db.Uuid
  cancelReason            String?                            @map("cancel_reason") @db.VarChar(500)
  cancelRequestedAt       DateTime?                          @map("cancel_requested_at")
  cancelledAt             DateTime?                          @map("cancelled_at")
  cancellationFinalizedBy AutomationCancellationFinalizedBy? @map("cancellation_finalized_by")
  triggerKind             AutomationTriggerKind              @map("trigger_kind")
  triggeredByUserId       String?                            @map("triggered_by_user_id") @db.Uuid
  triggeredByLabel        String?                            @map("triggered_by_label")
  appliedMode             AutomationMode                     @map("applied_mode")
  runbookKey              String?                            @map("runbook_key")
  runbookVersion          String?                            @map("runbook_version")
  engineExecutionId       String?                            @map("engine_execution_id")
  inputSnapshot           Json                               @map("input_snapshot")
  resultSummary           Json?                              @map("result_summary")
  analysisPayload         Json?                              @map("analysis_payload")
  errorCode               String?                            @map("error_code")
  errorMessage            String?                            @map("error_message")
  failedStepId            String?                            @map("failed_step_id")
  queryCount              Int?                               @map("query_count")
  bytesScanned            BigInt?                            @map("bytes_scanned")
  recordsScanned          BigInt?                            @map("records_scanned")
  recordsMatched          BigInt?                            @map("records_matched")
  dispatchAttempts        Int                                @default(0) @map("dispatch_attempts")
  totalWorkerAttempts     Int                                @default(0) @map("total_worker_attempts")
  deliveryCycle           Int                                @default(1) @map("delivery_cycle")
  cycleReceiveCount       Int                                @default(0) @map("cycle_receive_count")
  sqsMessageId            String?                            @map("sqs_message_id")
  queuedAt                DateTime?                          @map("queued_at")
  startedAt               DateTime?                          @map("started_at")
  lastHeartbeatAt         DateTime?                          @map("last_heartbeat_at")
  activeAttemptId         String?                            @unique @map("active_attempt_id") @db.Uuid
  workerDeadlineAt        DateTime?                          @map("worker_deadline_at")
  deadlineAt              DateTime                           @map("deadline_at")
  completedAt             DateTime?                          @map("completed_at")
  durationMs              Int?                               @map("duration_ms")
  createdAt               DateTime                           @default(now()) @map("created_at")
  updatedAt               DateTime                           @updatedAt @map("updated_at")

  parent            AutomaticRunbookExecution?  @relation("ExecutionChain", fields: [parentExecutionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          AutomaticRunbookExecution[] @relation("ExecutionChain")
  alarmEvent        AlarmEvent                  @relation("ExecutionAlarmEvent", fields: [alarmEventId], references: [id], onDelete: Restrict)
  analysis          AlarmAnalysis?              @relation("ExecutionAnalysis", fields: [analysisId], references: [id], onDelete: SetNull)
  triggeredBy       User?                       @relation("AutomationTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  reviewedBy        User?                       @relation("AutomationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  cancelRequestedBy User?                       @relation("AutomationCancelRequestedBy", fields: [cancelRequestedByUserId], references: [id], onDelete: SetNull)
  attempts          AutomaticRunbookAttempt[]   @relation("ExecutionAttempts")
  activeAttempt     AutomaticRunbookAttempt?    @relation("ExecutionActiveAttempt", fields: [activeAttemptId], references: [id], onDelete: Restrict)
  appliedToAnalyses AlarmAnalysis[]             @relation("AnalysisLastApplied")

  @@index([alarmEventId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([status, lastHeartbeatAt])
  @@index([status, workerDeadlineAt])
  @@index([status, deadlineAt])
  @@index([productId, environmentId, createdAt(sort: Desc)])
  @@index([alarmId, outcome, createdAt(sort: Desc)])
  @@index([reviewStatus, createdAt])
  @@index([analysisId])
  @@index([parentExecutionId])
  @@map("automatic_runbook_executions")
}

model AutomaticRunbookAttempt {
  id                    String                      @id @default(uuid(7)) @db.Uuid
  executionId           String                      @map("execution_id") @db.Uuid
  attemptNumber         Int                         @map("attempt_number")
  deliveryCycle         Int                         @map("delivery_cycle")
  cycleReceiveCount     Int                         @map("cycle_receive_count")
  sqsMessageId          String                      @map("sqs_message_id")
  status                AutomationAttemptStatus
  phase                 String?
  heartbeatSequence     Int                         @default(0) @map("heartbeat_sequence")
  retryDisposition      AutomationRetryDisposition? @map("retry_disposition")
  completionPayloadHash String?                     @map("completion_payload_hash") @db.VarChar(64)
  completionHashVersion String?                     @map("completion_hash_version") @db.VarChar(32)
  errorCode             String?                     @map("error_code")
  errorMessage          String?                     @map("error_message")
  startedAt             DateTime                    @default(now()) @map("started_at")
  lastHeartbeatAt       DateTime?                   @map("last_heartbeat_at")
  workerDeadlineAt      DateTime?                   @map("worker_deadline_at")
  finishedAt            DateTime?                   @map("finished_at")
  durationMs            Int?                        @map("duration_ms")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  execution          AutomaticRunbookExecution  @relation("ExecutionAttempts", fields: [executionId], references: [id], onDelete: Restrict)
  activeForExecution AutomaticRunbookExecution? @relation("ExecutionActiveAttempt")

  @@unique([executionId, attemptNumber])
  @@unique([executionId, sqsMessageId, cycleReceiveCount])
  @@index([executionId, startedAt(sort: Desc)])
  @@index([status, lastHeartbeatAt])
  @@map("automatic_runbook_attempts")
}
