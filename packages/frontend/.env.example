# API URL for client-side requests (browser).
# Relative URL goes through Next rewrites, so it also works behind ngrok.
NEXT_PUBLIC_API_URL=/watchtower-api
NEXT_PUBLIC_API_PROXY_PREFIX=/watchtower-api

# Backend URL for Next server-side requests and the browser API proxy.
API_URL_INTERNAL=http://localhost:3001
API_PROXY_TARGET=http://localhost:3001

# Extra hosts allowed by next dev. Comma-separated, hostnames only or URLs.
NEXT_ALLOWED_DEV_ORIGINS=*.ngrok-free.dev

# NextAuth Configuration - REQUIRED
# Generate a new secret with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-at-least-32-characters-long
NEXTAUTH_SECRET=your-secret-key-at-least-32-characters-long
# Leave NEXTAUTH_URL empty in local development if you want both localhost and
# ngrok to work. With AUTH_TRUST_HOST=true, NextAuth uses the request Host.
# Set a fixed NEXTAUTH_URL only when you intentionally want one canonical host.
# Example: NEXTAUTH_URL=https://your-domain.ngrok-free.dev
NEXTAUTH_URL=
AUTH_TRUST_HOST=true

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
